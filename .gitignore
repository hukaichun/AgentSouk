.venv/
__pycache__/
*.pyc
.env

# Local SQLite database files — souk's zero-config default backend writes
# ./souk.db (plus -wal/-shm sidecars) when SOUK_DATABASE_URL is unset. Local
# state, never commit; a real deployment uses Postgres instead.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Provider identity keys (see souk_agent_sdk/identity.py) — a credential,
# never commit one.
*.key
souk_identity.key

# Dev-only TLS cert/key generated by scripts/gen_dev_tls_cert.py.
dev_cert.pem
dev_key.pem


# souk-directory: compiled output + npm deps, regenerate via `npm run build`.
souk-directory/node_modules/
souk-directory/dist/

.pytest_cache/

