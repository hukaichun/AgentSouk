.venv/
__pycache__/
*.pyc
.env

# Provider identity keys (see souk_agent_sdk/identity.py) — a credential,
# never commit one.
*.key
souk_identity.key

# Generated by scripts/gen_proto.sh — regenerate, don't commit.
souk/souk/grpc_gen/*_pb2.py
souk/souk/grpc_gen/*_pb2.pyi
souk/souk/grpc_gen/*_pb2_grpc.py
souk-agent-sdk/souk_agent_sdk/grpc_gen/*_pb2.py
souk-agent-sdk/souk_agent_sdk/grpc_gen/*_pb2.pyi
souk-agent-sdk/souk_agent_sdk/grpc_gen/*_pb2_grpc.py
