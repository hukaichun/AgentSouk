
# Used when an agent's config.yaml sets `model: custom-openai` (or
# `custom-openai:<name>`, overriding LLM_MODEL_NAME) — any OpenAI-compatible
# endpoint (Azure AI, self-hosted gateway, ...). See agent_template.main.resolve_model.
LLM_BASE_URL="https://agentfunduq.services.ai.azure.com/openai/v1"
LLM_MODEL_NAME="DeepSeek-V4-Flash"
LLM_API_KEY="sk-..."

# Used when an agent's config.yaml sets a plain "anthropic:claude-..." model instead.
ANTHROPIC_API_KEY=sk-ant-...

# Only used by the optional `hermes-demo` compose profile (providers/
# openai-compat-agent) — bearer token for Hermes Agent's own OpenAI-
# compatible API server. Any random string >=16 chars; generate with
# e.g. `python3 -c "import secrets; print(secrets.token_hex(16))"`.
HERMES_API_SERVER_KEY=
